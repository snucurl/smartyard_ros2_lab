<?xml version="1.0"?>
<package format="3">
  <name>smartyard_lab</name><version>1.0.0</version>
  <description>Python multi-PC smart yard lab for ROS 2 Humble.</description>
  <maintainer email="maintainer@example.com">Smart Yard Course</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>smartyard_interfaces</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
